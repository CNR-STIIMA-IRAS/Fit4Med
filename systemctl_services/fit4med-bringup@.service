[Unit]
Description=Fit4Med ROS bringup for GUI %I

[Service]
Type=simple
WorkingDirectory=/home/fit4med/fit4med_ws
ExecStart=/home/fit4med/fit4med_ws/src/Fit4Med/bash_scripts/fit4med_bringup_service.sh %I
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=15
SendSIGKILL=yes
Restart=no
StandardOutput=journal
StandardError=journal
Environment=ROS_DOMAIN_ID=1
Environment=RMW_IMPLEMENTATION=rmw_fastrtps_cpp
Environment=ROS_LOCALHOST_ONLY=1
Environment=PYTHONUNBUFFERED=1
Environment=RCUTILS_LOGGING_BUFFERED_STREAM=1
Environment=RCUTILS_COLORIZED_OUTPUT=0
Environment="RCUTILS_CONSOLE_OUTPUT_FORMAT=[{severity}] [{time}] [{name}]: {message}"
# Bringup config (currently just EEG_DELAY_MS) lives outside the repo so a
# `git pull`/reinstall never touches it. First-time setup: copy
# bash_scripts/fit4med_bringup_config.template.json to the path below and
# fill it in.
Environment="FIT4MED_BRINGUP_CONFIG=%h/.config/fit4med/bringup_config.json"

[Install]
WantedBy=default.target
