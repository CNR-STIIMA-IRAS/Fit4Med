[Unit]
Description=Fit4Med ROS bringup for GUI %I

[Service]
Type=simple
WorkingDirectory=/home/fit4med/fit4med_ws
ExecStart=/home/fit4med/fit4med_ws/src/Fit4Med/bash_scripts/fit4med_bringup_service.sh %I
# mixed: `systemctl stop` sends SIGINT only to the main process (ros2 launch,
# exec'd by the script), which stops its nodes in order: plc_manager raises
# the SW ESTOP and stops the platform/rosbridge launches it started, then the
# PLC ros2_control_node stops (shutdown_guard, run_sickPLC.launch.py).
# control-group signalled every process at once: the PLC EtherCAT master
# stopped before plc_manager could send the ESTOP (run 0092). Processes still
# left when the timeout expires get SIGKILL.
KillMode=mixed
KillSignal=SIGINT
# Room for the nodes to stop and for run_sickPLC.launch.py to archive the
# logs of the run (journal + zip, see bash_scripts/fit4med_session_log.sh).
TimeoutStopSec=60
SendSIGKILL=yes
Restart=no
StandardOutput=journal
StandardError=journal
Environment=ROS_DOMAIN_ID=1
Environment=RMW_IMPLEMENTATION=rmw_fastrtps_cpp
Environment=ROS_LOCALHOST_ONLY=1
Environment=PYTHONUNBUFFERED=1
Environment=RCUTILS_LOGGING_BUFFERED_STREAM=1
Environment=RCUTILS_COLORIZED_OUTPUT=0
Environment="RCUTILS_CONSOLE_OUTPUT_FORMAT=[{severity}] [{time}] [{name}]: {message}"
# Bringup config (currently just EEG_DELAY_MS) lives outside the repo so a
# `git pull`/reinstall never touches it. First-time setup: copy
# bash_scripts/fit4med_bringup_config.template.json to the path below and
# fill it in.
Environment="FIT4MED_BRINGUP_CONFIG=%h/.config/fit4med/bringup_config.json"

[Install]
WantedBy=default.target
